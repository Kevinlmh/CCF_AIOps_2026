{
  "schema_version": 1,
  "batch": "stage1-local",
  "raw_root": "../../data/stage1/regions",
  "naive_timezone": "UTC",
  "features": {"netflow_streaming": true},
  "storage": {"compact": true},
  "evidence": {"observations_per_kind": 2},
  "states": {
    "mode": "hybrid", "min_reference": 12, "clusters": 3,
    "stat_threshold": 8, "cluster_threshold": 4, "rare_fraction": 0,
    "rules_enabled": true, "candidate_policy": "conservative", "candidate_min_windows": 2
  },
  "agents": {"discovery_only": true},
  "backend": {"kind": "replay", "model": "offline-no-model", "replay_file": "empty-replay.jsonl"},
  "profile": {"max_rows_per_file": null}
}
