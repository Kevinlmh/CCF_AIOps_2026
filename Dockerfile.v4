# For immutable rebuilds, override PYTHON_IMAGE with the recorded repository digest.
ARG PYTHON_IMAGE=python:3.12-slim
FROM ${PYTHON_IMAGE} AS runtime
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app
COPY aiops_common /app/aiops_common
COPY aiops_challenge_2026 /app/aiops_challenge_2026
COPY aiops_v4 /app/aiops_v4
COPY LICENSE /app/LICENSE
COPY configs/v4 /app/configs/v4
ENTRYPOINT ["python", "-m", "aiops_v4.experiments"]
CMD ["--help"]

FROM runtime AS test
ARG PYTEST_VERSION=9.1.1
RUN python -m pip install --no-cache-dir pytest==${PYTEST_VERSION}
COPY tests /app/tests
ENTRYPOINT ["python", "-m", "pytest"]
CMD ["tests/v4", "-q"]
