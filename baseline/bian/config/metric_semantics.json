{
  "default": {"kind": "gauge", "direction": "both"},
  "rules": [
    {"pattern": "traffic.*.active", "kind": "context", "direction": "state", "detect": false},
    {"pattern": "traffic.*.batch_concurrency", "kind": "context", "direction": "both", "detect": false},
    {"pattern": "traffic.*.last_batch_timestamp_seconds", "kind": "context", "direction": "both", "detect": false},
    {"pattern": "traffic.*.request_latency_seconds_bucket_rate*", "kind": "context", "direction": "both", "detect": false},
    {"pattern": "traffic.*.counter_reset", "kind": "context", "direction": "state", "detect": false},
    {"pattern": "node.memory_available_ratio", "kind": "gauge", "direction": "low"},
    {"pattern": "node.cpu_usage", "kind": "gauge", "direction": "high", "scoring_direction": "both"},
    {"pattern": "node.load*", "kind": "gauge", "direction": "high", "scoring_direction": "both", "event_role": "support"},
    {"pattern": "node.swap_used_ratio", "kind": "gauge", "direction": "high", "scoring_direction": "both"},
    {"pattern": "node.disk_read_rate", "kind": "gauge", "direction": "high", "scoring_direction": "both", "event_role": "support"},
    {"pattern": "node.disk_write_rate", "kind": "gauge", "direction": "high", "scoring_direction": "both", "event_role": "support"},
    {"pattern": "node.disk_*", "kind": "gauge", "direction": "high", "scoring_direction": "both"},
    {"pattern": "node.filesystem_used_ratio", "kind": "gauge", "direction": "high", "scoring_direction": "both"},
    {"pattern": "node.inode_used_ratio", "kind": "gauge", "direction": "high", "scoring_direction": "both"},
    {"pattern": "node.open_fd_ratio", "kind": "gauge", "direction": "high", "scoring_direction": "both"},
    {"pattern": "node.process_count", "kind": "gauge", "direction": "high", "scoring_direction": "both"},
    {"pattern": "interface.carrier_changes", "kind": "counter", "direction": "high"},
    {"pattern": "interface.*drop*", "kind": "gauge", "direction": "high"},
    {"pattern": "interface.*error*", "kind": "gauge", "direction": "high"},
    {"pattern": "interface.*_bytes_rate", "kind": "gauge", "direction": "both", "event_role": "support"},
    {"pattern": "interface.*_packets_rate", "kind": "gauge", "direction": "both", "event_role": "support"},
    {"pattern": "routing.*change*_total", "kind": "counter", "direction": "high"},
    {"pattern": "routing.*changed*_total", "kind": "counter", "direction": "high"},
    {"pattern": "routing.*peer_up", "kind": "state", "direction": "low", "normal_value": 1.0},
    {"pattern": "routing.*enabled", "kind": "state", "direction": "low"},
    {"pattern": "routing.*route_exists", "kind": "state", "direction": "low"},
    {"pattern": "routing.*command_success", "kind": "state", "direction": "low", "normal_value": 1.0},
    {"pattern": "routing.*state_code", "kind": "state", "direction": "low"},
    {"pattern": "routing.*uptime_seconds", "kind": "gauge", "direction": "both", "event_role": "support"},
    {"pattern": "scrape.scrape_up", "kind": "state", "direction": "low", "normal_value": 1.0},
    {"pattern": "scrape.scrape_samples", "kind": "gauge", "direction": "low", "event_role": "support"},
    {"pattern": "scrape.scrape_duration_seconds", "kind": "gauge", "direction": "high", "event_role": "support"},
    {"pattern": "traffic.*.request_latency_seconds_sum_rate", "kind": "gauge", "direction": "both", "event_role": "support"},
    {"pattern": "traffic.*.request_latency_seconds_count_rate", "kind": "gauge", "direction": "both", "event_role": "support"},
    {"pattern": "traffic.*.*success*_ratio", "kind": "gauge", "direction": "low"},
    {"pattern": "traffic.*.*error_rate", "kind": "gauge", "direction": "high", "event_role": "support"},
    {"pattern": "traffic.*.*throughput*", "kind": "gauge", "direction": "low", "event_role": "support"},
    {"pattern": "traffic.*.*observed_qps*", "kind": "gauge", "direction": "low", "event_role": "support"},
    {"pattern": "traffic.*.*error*", "kind": "gauge", "direction": "high"},
    {"pattern": "traffic.*.*timeout*", "kind": "gauge", "direction": "high"},
    {"pattern": "traffic.*.*latency*", "kind": "gauge", "direction": "high"},
    {"pattern": "traffic.*.*loss*", "kind": "gauge", "direction": "high"},
    {"pattern": "traffic.*.*retransmit*", "kind": "gauge", "direction": "high"},
    {"pattern": "traffic.*.*jitter*", "kind": "gauge", "direction": "high"},
    {"pattern": "traffic.*.batch_duration_seconds", "kind": "gauge", "direction": "both", "event_role": "support"},
    {"pattern": "traffic.*.*_rate", "kind": "gauge", "direction": "both", "event_role": "support"},
    {"pattern": "netflow.*", "kind": "gauge", "direction": "both", "event_role": "support"},
    {"pattern": "frr.*", "kind": "event", "direction": "high"}
  ]
}
